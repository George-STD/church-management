# ==============================================================================
# Church Service Management System - Environment Configuration
# ==============================================================================

PORT=5000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# ==============================================================================
# Supabase & PostgreSQL Configuration
# ==============================================================================
# 1. Go to your Supabase project dashboard: https://supabase.com/dashboard/project/<your-project-id>/settings/database
# 2. In "Connection string", select "URI":
#    - For pooled connection (Transaction mode, port 6543): Use for DATABASE_URL
#    - For direct connection (Session mode, port 5432): Use for DIRECT_URL
# Example format:
# postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true
DATABASE_URL="postgresql://postgres:your-supabase-password@db.your-supabase-id.supabase.co:6543/postgres?pgbouncer=true"

# Example direct connection (Port 5432, without pgbouncer):
DIRECT_URL="postgresql://postgres:your-supabase-password@db.your-supabase-id.supabase.co:5432/postgres"

# Supabase API credentials (found under Project Settings -> API)
SUPABASE_URL="https://your-project-id.supabase.co"
SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# ==============================================================================
# Security & JWT Secrets
# ==============================================================================
JWT_SECRET="church-service-management-super-secret-cryptographic-key-2026"
JWT_EXPIRES_IN="7d"
COOKIE_SECRET="church-service-cookie-secret-2026"
ENCRYPTION_KEY="32-character-random-hex-string-for-aes-256"

# Consecutive absence alert threshold (Default 2 consecutive missed weeks)
ABSENCE_ALERT_THRESHOLD=2
